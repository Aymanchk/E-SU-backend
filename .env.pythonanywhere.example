# ==============================================================================
# Конфигурация окружения E-SU для PythonAnywhere (.env)
# ==============================================================================

# Режим отладки (False для production, True если нужно посмотреть ошибки)
DEBUG=False

# Секретный ключ Django (рекомендуется сгенерировать случайную строку)
SECRET_KEY=django-insecure-esu-pythonanywhere-key-2026-production-ready

# Разрешенные хосты (* разрешает любые домены)
ALLOWED_HOSTS=*

# CORS: разрешить любые источники для frontend
CORS_ALLOW_ALL_ORIGINS=True

# Версия API
API_VERSION=v1

# База данных (SQLite по умолчанию не требует настройки)
# DATABASE_URL=sqlite:///db.sqlite3

# Фоновые задачи Celery (выполняются синхронно в процессе)
CELERY_TASK_ALWAYS_EAGER=True

# Настройки Email (опционально: если оставить пустыми, письма пишутся в консоль)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=noreply@esu.kg
